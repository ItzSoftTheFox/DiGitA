# Run commands from backend/. These defaults match compose.yaml.
DIGITA_DATABASE_URL=postgresql+psycopg://digita:digita-local@127.0.0.1:5433/digita
DIGITA_SESSION_HOURS=24
DIGITA_INVITE_HOURS=48
DIGITA_AUTH_REQUESTS_PER_MINUTE=20
# Optional override: exact trusted browser/Tauri origins, encoded as a JSON array.
# DIGITA_ALLOWED_ORIGINS=["http://127.0.0.1:1420","tauri://localhost","http://tauri.localhost","https://tauri.localhost"]
# Per-process HTTP budget per client IP (including auth and health).
DIGITA_API_REQUESTS_PER_MINUTE=120
DIGITA_MAX_REQUEST_BYTES=16384
# Close registration after onboarding pilot accounts.
DIGITA_REGISTRATION_ENABLED=true
